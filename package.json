{
  "name": "tsuki-anime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukigamine/tsuki-anime.git"
  },
  "bugs": {
    "url": "https://github.com/Yukigamine/tsuki-anime/issues"
  },
  "homepage": "https://github.com/Yukigamine/tsuki-anime#readme",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome lint --write",
    "lint-check": "biome check && knip",
    "lint-staged": "lint-staged",
    "format": "biome format --write",
    "check": "biome check --write",
    "knip": "knip",
    "knip:deps": "knip --dependencies",
    "prepare": "prisma generate && husky",
    "deploy": "prisma generate && prisma migrate deploy && next build",
    "db-edit": "prisma studio",
    "db-init": "prisma migrate reset",
    "zeus:kitsu": "tsx scripts/zeus-gen.ts https://kitsu.app/api/graphql src/lib/zeus/kitsu --graphql=graphql/kitsu.schema.graphql",
    "zeus:anilist": "tsx scripts/zeus-gen.ts https://graphql.anilist.co src/lib/zeus/anilist --graphql=graphql/anilist.schema.graphql"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "^1.6.23",
    "next": "16.2.6",
    "notistack": "3.0.2",
    "prisma": "7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "redis": "4.7.1",
    "swr": "2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@prisma/adapter-pg": "7.8.0",
    "@serwist/next": "9.5.11",
    "@serwist/turbopack": "9.5.11",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "esbuild": "0.28.0",
    "graphql-zeus": "7.2.1",
    "husky": "9.1.7",
    "knip": "6.14.2",
    "lint-staged": "17.0.5",
    "server-only": "0.0.1",
    "serwist": "9.5.11",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.14.0"
}
